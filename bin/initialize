#!/bin/zsh

set -u
setopt extendedglob # for (#m) and ##

# MOD's internal name: current directory (rename afterward if needed)
MOD_NAME="$PWD:t"
# Title-ize the internal name (mod_name => Mod Name)
MOD_TITLE=${(C)${${${MOD_NAME}//(#m)[^[:alnum:]]##/ }## }%% }
# License identifier. Defaults to MIT
: ${MOD_LICENSE:="default_mit"}

# Install runtimes via mise
print "Install tools via mise ..."
mise install

# Author name: GitHub repository owner (edit info.json afterward if needed)
AUTHOR_NAME="$(gh api repos/:owner/:repo --jq '.owner.login')"

# Replace README.md with just the MOD title
print "Overwriting README.md ..."
gh api repos/:owner/:repo \
  --jq '.template_repository | "\(.full_name) \(.html_url)"' | \
  read -r TEMPLATE_REPO TEMPLATE_REPO_URL
cat >README.md <<README
# ${MOD_TITLE}

[![Downloads](https://img.shields.io/badge/dynamic/json.svg?label=Downloads&url=https%3A%2F%2Fmods.factorio.com%2Fapi%2Fmods%2F${MOD_NAME}&query=%24.downloads_count)](https://mods.factorio.com/mod/${MOD_NAME})

Generated from [${TEMPLATE_REPO}](${TEMPLATE_REPO_URL})
README

# Generate info.json
print "Generating info.json ..."
read -r -d '' INFO_JSON_TEMPLATE <<'INFO_JSON_TEMPLATE'
{
  "name": $name,
  "version": "0.0.1",
  "title": $title,
  "author": $author,
  "description": $title,
  "factorio_version": "2.1",
  "dependencies": [
    "base >= 2.1"
  ]
}
INFO_JSON_TEMPLATE

jq -n \
  --arg name "${MOD_NAME}" \
  --arg title "${MOD_TITLE}" \
  --arg author "${AUTHOR_NAME}" \
  "${INFO_JSON_TEMPLATE}" > info.json

# Generate local/en/mod_name.cfg
print "Generating locale/en/${MOD_NAME}.cfg ..."
mkdir -p locale/en

cat >"locale/en/${MOD_NAME}.cfg" <<LOCALE_EN_CFG
[mod-name]
${MOD_NAME}=${MOD_TITLE}

[mod-description]
${MOD_NAME}=${MOD_TITLE}
LOCALE_EN_CFG

# Generate changelog.txt
print "Generating changelog.txt ..."
cat >changelog.txt <<'CHANGELOG_TXT'
---------------------------------------------------------------------------------------------------
Version: Unreleased
CHANGELOG_TXT

# Replace LICENSE.txt
print "Replacing LICENSE.txt ..."
curl -sL "$(factorix mod license show "${MOD_LICENSE}" --json | jq -r .url)" -o LICENSE.txt

# MIT license requires some replacements
if [[ "${MOD_LICENSE}" = "default_mit" ]]; then
  CURRENT_DATE_UTC="$(date -u +%Y-%m-%d)"
  CURRENT_YEAR_UTC="${CURRENT_DATE_UTC%%-*}"
  GIT_USER_NAME="$(git config user.name)"
  (
    rm -f LICENSE.txt &&
    sed \
      -e 's/<year>/'"${CURRENT_YEAR_UTC}"'/' \
      -e 's/<copyright holders>/'"${GIT_USER_NAME}"'/' > LICENSE.txt
  ) < LICENSE.txt
fi

# Configure release settings in mise.toml
print "Configuring release settings in mise.toml ..."
# mise set merges into the existing [env] table. A literal append would emit a
# second [env] header, which is a duplicate-key error in TOML.
mise set MOD_LICENSE="${MOD_LICENSE}" MOD_CATEGORY=no-category MOD_TAGS=

# Repository configuration
print "Configuring GitHub repository settings..."
# Enable auto-deletion of head branches after merge
if gh api --silent --method PATCH repos/:owner/:repo -F delete_branch_on_merge=true; then
  print -- "- Enabled automatic branch deletion after merge"
else
  print -- "- Could not enable automatic branch deletion (may need to be set manually)"
fi
# Enable auto-merge for pull requests (required for Renovate's platformAutomerge)
if gh api --silent --method PATCH repos/:owner/:repo -F allow_auto_merge=true; then
  print -- "- Enabled auto-merge for pull requests"
else
  print -- "- Could not enable auto-merge (may need to be set manually)"
fi
# Enable GitHub Discussions
if gh api --silent --method PATCH repos/:owner/:repo -F has_discussions=true; then
  print -- "- Enabled GitHub Discussions"
else
  print -- "- Could not enable GitHub Discussions (may need to be set manually)"
fi
# Set repository topics
if gh api --silent --method PUT repos/:owner/:repo/topics --input - <<'TOPICS_JSON'
{
  "names": ["factorio-mod"]
}
TOPICS_JSON
then
  print -- "- Set repository topic to 'factorio-mod'"
else
  print -- "- Could not set repository topic (may need to be set manually)"
fi
# Set repository website to the MOD portal page
if gh api --silent --method PATCH repos/:owner/:repo -f homepage="https://mods.factorio.com/mod/${MOD_NAME}"; then
  print -- "- Set repository website to the MOD portal page"
else
  print -- "- Could not set repository website (may need to be set manually)"
fi
# Define project-specific issue labels. GitHub auto-provisions its standard set
# (bug, enhancement, accessibility, ...) on repository creation; these are the
# extra labels this project relies on and GitHub does not create.
print "Defining project-specific issue labels ..."
PROJECT_LABELS=(
  'chore:e4b429:Maintenance, tooling, and housekeeping'
  'test:0e8a16:Tests and test infrastructure'
  'refactor:d4c5f9:Code restructuring without changing external behavior'
  'icebox:add8e6:Parked for the future; not scheduled for work'
  'run-ci:1d76db:Add to a scaffold-drift PR to run CI (a GITHUB_TOKEN PR does not trigger workflows)'
)
for label_spec in "${PROJECT_LABELS[@]}"; do
  label_name="${label_spec%%:*}"
  label_rest="${label_spec#*:}"
  label_color="${label_rest%%:*}"
  label_description="${label_rest#*:}"
  # --force so a re-run, or a name GitHub already took, updates instead of failing
  if gh label create "${label_name}" --color "${label_color}" --description "${label_description}" --force >/dev/null 2>&1; then
    print -- "- Defined '${label_name}' label"
  else
    print -- "- Could not define '${label_name}' label (may need to be created manually)"
  fi
done
# Require pull requests before merging to main (needed for auto-merge to work)
DEFAULT_BRANCH="$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name)"
if gh api --method PUT "repos/:owner/:repo/branches/${DEFAULT_BRANCH}/protection" --input - <<'PROTECTION_JSON' >/dev/null; then
{
  "required_status_checks": {
    "strict": false,
    "contexts": ["test"]
  },
  "enforce_admins": false,
  "required_pull_request_reviews": {
    "required_approving_review_count": 0
  },
  "restrictions": null,
  "allow_force_pushes": false,
  "allow_deletions": false
}
PROTECTION_JSON
  print -- "- Required pull requests before merging to ${DEFAULT_BRANCH}"
else
  print -- "- Could not set branch protection (may need to be set manually)"
fi
# Set workflow permissions to read/write and allow PR creation
if gh api --method PUT repos/:owner/:repo/actions/permissions/workflow \
  -F default_workflow_permissions=write \
  -F can_approve_pull_request_reviews=true 2>/dev/null; then
  print -- "- Workflow permissions set to 'Read and write'"
  print -- "- GitHub Actions allowed to create and approve pull requests"
else
  print -- "- Could not configure workflow permissions (may need to be set manually)"
fi
# Create release environment
if gh api --silent --method PUT repos/:owner/:repo/environments/release; then
  print -- "- Created 'release' environment"
else
  print -- "- Could not create 'release' environment (may need to be created manually)"
fi
# Set FACTORIO_API_KEY secret for release environment
print "** FACTORIO_API_KEY is used to publish MODs to the Factorio MOD portal. **"
print "** Get your API key at https://www.factorio.com/profile **"
print "** (Leave empty to skip and set it manually later) **"
read -rs "FACTORIO_API_KEY?Enter FACTORIO_API_KEY: "
print
if [[ -n "${FACTORIO_API_KEY}" ]]; then
  if gh secret set FACTORIO_API_KEY --env release --body "${FACTORIO_API_KEY}"; then
    print -- "- Set FACTORIO_API_KEY secret for 'release' environment"
  else
    print -- "- Could not set FACTORIO_API_KEY secret (may need to be set manually)"
  fi
else
  print -- "- Skipped FACTORIO_API_KEY (empty input, set it manually later)"
fi

# Record the scaffold commit this MOD is generated from, for scaffold-drift sync.
# NOTE: this is the scaffold's live HEAD now, which matches the template snapshot
# only if no scaffold commit landed between "Use this template" and this run.
# Commits made in that window are baselined out -- the first scaffold-drift PR
# will not carry their changes (a later scaffold edit to the same files still
# syncs). The window is normally minutes; review the first chore/scaffold-drift
# PR if the scaffold was active around then.
SCAFFOLD_HEAD="$(git ls-remote https://github.com/sakuro/factorio-mod-scaffold HEAD | cut -f1)"
if [[ -n "${SCAFFOLD_HEAD}" ]]; then
  jq -n --arg repo "https://github.com/sakuro/factorio-mod-scaffold" \
        --arg commit "${SCAFFOLD_HEAD}" \
        --arg synced_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{repo: $repo, commit: $commit, synced_at: $synced_at}' > .scaffold-sync.json
  print -- "- Wrote .scaffold-sync.json (baseline ${SCAFFOLD_HEAD})"
else
  print -- "- Could not resolve scaffold HEAD; create .scaffold-sync.json manually"
fi

# ANTHROPIC_API_KEY drives .github/workflows/scaffold-drift.yml. Repo-level secret
# (the workflow reads secrets.ANTHROPIC_API_KEY at repo scope). Leaving it blank
# is fine — the workflow's gate step then no-ops until the secret is added.
print "** ANTHROPIC_API_KEY runs the weekly scaffold-drift workflow (Claude Code Action). **"
print "** Create one at https://console.anthropic.com/ (pay-as-you-go, separate from any subscription). **"
print "** (Leave empty to skip and set it manually later) **"
read -rs "ANTHROPIC_API_KEY?Enter ANTHROPIC_API_KEY: "
print
if [[ -n "${ANTHROPIC_API_KEY}" ]]; then
  if gh secret set ANTHROPIC_API_KEY --body "${ANTHROPIC_API_KEY}"; then
    print -- "- Set ANTHROPIC_API_KEY secret"
  else
    print -- "- Could not set ANTHROPIC_API_KEY secret (may need to be set manually)"
  fi
else
  print -- "- Skipped ANTHROPIC_API_KEY (empty input, set it manually later)"
fi

# Finalize initialization
print "Finalizing MOD initialization ..."
git rm bin/initialize
git add .

name_with_owner="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
template_name_with_owner="$(gh api repos/:owner/:repo --jq '.template_repository.full_name')"
git commit --amend -m ":tada: Initialized ${name_with_owner} from ${template_name_with_owner}"

print "Prepared repository for ${MOD_NAME}"
